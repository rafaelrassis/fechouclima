generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum NudgeKind {
  NUDGE
  SNOOZE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  sessionsValidAfter    DateTime?
  phone                 String?
  companyName           String?
  waTemplate            String?
  nudgeTemplate         String?
  approvalWaTemplate    String?
  emailDigest           Boolean   @default(true)
  termsAcceptedAt       DateTime?
  pixKey                String?
  pixKeyType            String?
  pixCity               String?
  brandColor            String?
  logo                  Bytes?
  logoType              String?
  logoUpdatedAt         DateTime?
  quoteSeq              Int       @default(0)
  referralCode          String?   @unique
  referredById          String?
  defaultReminderMonths Int?      @default(6)
  isAdmin               Boolean   @default(false)
  isActive              Boolean   @default(true)
  deactivatedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  services            Service[]
  quotes              Quote[]
  customers           Customer[]
  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  nudges              QuoteNudge[]
  referredBy          User?                @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]               @relation("Referrals")

  @@index([referredById])
  @@index([isActive, createdAt])
}

// userId null = serviço padrão do sistema (seed); preenchido = catálogo do usuário
model Service {
  id             String   @id @default(cuid())
  userId         String?
  // preenchido = personalização do técnico sobre um serviço padrão (o padrão nunca é alterado)
  overridesId    String?
  name           String
  description    String?
  unit           String   @default("un")
  priceCents     Int
  isActive       Boolean  @default(true)
  // null = sem lembrete; só 3, 6 ou 12
  reminderMonths Int?
  reminderText   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides    Service?    @relation("ServiceOverride", fields: [overridesId], references: [id], onDelete: Cascade)
  overriddenBy Service[]   @relation("ServiceOverride")
  items        QuoteItem[]

  @@unique([userId, overridesId])
  @@index([userId, isActive])
}

model Quote {
  id                 String      @id @default(cuid())
  publicId           String      @unique @default(uuid())
  number             Int
  userId             String
  customerId         String?
  customerName       String
  customerPhone      String
  customerAddress    String?
  title              String?
  notes              String?
  status             QuoteStatus @default(DRAFT)
  discountCents      Int         @default(0)
  totalCents         Int         @default(0)
  validUntil         DateTime?
  sentAt             DateTime?
  viewedAt           DateTime?
  respondedAt        DateTime?
  rejectReason       String?
  paidAt             DateTime?
  reminderAt         DateTime?
  reminderDoneAt     DateTime?
  // snapshot na aprovação: o catálogo pode mudar depois sem alterar lembretes já agendados
  reminderText       String?
  reminderService    String?
  reminderNotifiedAt DateTime?
  lastNudgeAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    QuoteItem[]
  photos   QuotePhoto[]
  nudges   QuoteNudge[]
  visits   QuoteVisit[]

  @@unique([userId, number])
  @@index([userId, status, createdAt])
  @@index([userId, reminderAt])
}

model QuoteItem {
  id             String  @id @default(cuid())
  quoteId        String
  serviceId      String?
  description    String
  unit           String  @default("un")
  quantity       Decimal @db.Decimal(10, 2)
  unitPriceCents Int
  totalCents     Int
  position       Int     @default(0)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
}

// Rate limit em Postgres: janela fixa por chave (ex.: "login:ip:email")
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Cliente do técnico (autocomplete). O orçamento mantém seu próprio snapshot de nome/telefone/endereço.
model Customer {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String // só dígitos
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@unique([userId, phone])
  @@index([userId, updatedAt])
}

// Assinatura de web push de um aparelho do técnico (um técnico pode ter vários)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Token de recuperação de senha: guardamos só o hash (SHA-256); uso único e validade curta
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Foto anexada ao orçamento (até 4). O navegador reduz para 1280px JPEG antes de enviar.
model QuotePhoto {
  id        String   @id @default(cuid())
  quoteId   String
  data      Bytes
  type      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
}

// Histórico de cobranças (NUDGE) e adiamentos (SNOOZE) do técnico; alimenta o funil dos últimos 30 dias.
// Quote.lastNudgeAt continua sendo o que esconde o orçamento das listas.
// Toda abertura do link público por terceiros (não o dono), com origem opcional (?src=maps).
// viewedAt guarda só a 1ª; esta tabela serve para medir canais/demo.
model QuoteVisit {
  id        String   @id @default(cuid())
  quoteId   String
  src       String?
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([src, createdAt])
}

model QuoteNudge {
  id        String    @id @default(cuid())
  quoteId   String
  userId    String
  kind      NudgeKind
  createdAt DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([quoteId])
}
